# ---------------------------------------------------------------------------
# movie-money — example environment file
#
# Copy this file to `.env` and replace every placeholder with your own values.
#   cp .env.example .env
#
# `.env` is git-ignored. Never commit real tokens, passwords or channel IDs.
#
# NOTE: the Prisma CLI loads `.env` automatically, but the NestJS application
# does not register `@nestjs/config` or `dotenv`. When you run the app, make
# sure these variables are exported into the process environment, e.g.:
#   set -a; source .env; set +a; npm run start:dev
# ---------------------------------------------------------------------------

# --- Telegram -------------------------------------------------------------
# Bot token issued by @BotFather. Required — the bot cannot start without it.
# Read in: src/modules/bot/bot.service.ts
BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Numeric ID of the private channel that movies are forwarded from.
# Optional. When set, a message an admin forwards from this channel is treated
# as a movie upload. Supergroup/channel IDs start with -100.
# Read in: src/modules/bot/bot.service.ts
CHANNEL_UZ_ID=-1001234567890

# --- Database -------------------------------------------------------------
# PostgreSQL connection string used by the Prisma datasource.
# Required — used by both the Prisma CLI and the running application.
# Read in: prisma/schema.prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/movie_money?schema=public

# --- HTTP server ----------------------------------------------------------
# Port for the NestJS HTTP server (health/hello endpoint). Optional.
# Defaults to 3000 when unset.
# Read in: src/main.ts
PORT=3000

# Comma-separated Telegram user IDs with super-admin rights (add/remove movies,
# channels, admins, and broadcast). Get your ID from @userinfobot.
# If empty, the bot has no super admins and the admin panel is inaccessible.
SUPER_ADMIN_IDS=111111111,222222222
